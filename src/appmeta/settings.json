{
  "format_version": 1,
  "version": 2,
  "fields": {
    "host": {
      "type": "string",
      "label": "Computer address",
      "description": "Filled in automatically by the installer. IP address of the computer running Glances, e.g. 192.168.1.10; add :port if not 61208.",
      "default": "",
      "max_length": 64
    },
    "refresh": {
      "type": "enum",
      "label": "Update every",
      "description": "Time between samples.",
      "default": "2",
      "options": [
        { "value": "0.5", "label": "0.5 s" },
        { "value": "1", "label": "1 s" },
        { "value": "2", "label": "2 s" },
        { "value": "5", "label": "5 s" },
        { "value": "10", "label": "10 s" },
        { "value": "30", "label": "30 s" }
      ]
    },
    "install": {
      "type": "group",
      "label": "Install",
      "description": "FAQ: github.com/mrlunev/busybar-host-load",
      "fields": {
        "mac": {
          "type": "string",
          "label": "Install on Mac or Linux",
          "description": "Paste into Terminal.",
          "default": "curl -fsSL https://raw.githubusercontent.com/mrlunev/busybar-host-load/main/install.sh | bash",
          "max_length": 255
        },
        "windows": {
          "type": "string",
          "label": "Install on Windows",
          "description": "Paste into PowerShell.",
          "default": "irm https://raw.githubusercontent.com/mrlunev/busybar-host-load/main/install.ps1 | iex",
          "max_length": 255
        }
      }
    }
  }
}
